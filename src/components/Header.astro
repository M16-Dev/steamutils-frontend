---
import { Button } from "@/components/ui/button";
import { LINKS } from "@/lib/config";
---

<header class="sticky top-0 z-100 w-full border-b border-zinc-900 bg-zinc-950/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-2">
            <img src="/logo.svg" width="22" alt="SteamUtils Logo" />
            <span class="text-xl font-black tracking-tight">SteamUtils<span class="text-zinc-500">.app</span></span>
        </div>
        <div class="flex items-center gap-10">
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-400">
                <a href="#hero" class="transition-colors hover:text-zinc-100">Home</a>
                <a href="#features" class="transition-colors hover:text-zinc-100">Features</a>
                <a href={LINKS.docsUrl} class="transition-colors hover:text-zinc-100">API Docs</a>
            </nav>

            <div class="flex items-center">
                <a href={LINKS.botInviteUrl}>
                    <Button client:load variant="outline" size="lg" className="cursor-pointer">
                        Add to server
                    </Button>
                </a>
            </div>
        </div>
    </div>
</header>
