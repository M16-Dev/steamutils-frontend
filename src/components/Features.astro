---
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { AnimatedGradientWrapper } from "@/components/ui/animated-gradient-wrapper";
import { Link2, IdCard, Ticket, MessagesSquare, Code2, LineChart, Gamepad2, Sparkles } from "lucide-react";

const TAGS = {
	inProgress: {
		name: "In Progress",
		color: "bg-blue-500/15 text-blue-400 border-blue-500/30"
	},
};

const FEATURES = [
	{
		title: "Account Linking",
		description: "Check Steam user info using its Discord username. Create Discord role and provide in-game rewards via our API to verified players.",
		icon: Link2,
	},
	{
		title: "Player Info Panels",
		description: "Modern Discord panels to display comprehensive player information at a glance without leaving the app.",
		icon: IdCard,
	},
	{
		title: "Advanced Tickets",
		description: "Next-gen support ticket system with deep game server data integration to provide context instantly.",
		icon: Ticket,
		tags: [TAGS.inProgress]
	},
	// {
	// 	title: "Cross-Chat",
	// 	description: "Real-time, seamless chat synchronization between your game server and your Discord community.",
	// 	icon: MessagesSquare,
	// 	tags: [TAGS.inProgress]
	// },
	{
		title: "Developer API",
		description: "Powerful REST API to fetch verified user data and build custom integrations in the future.",
		icon: Code2,
	},
	{
		title: "Server Monitoring",
		description: "Modern-looking live player count charts and server activity tracking directly embedded in your Discord text channels.",
		icon: LineChart,
	},
	{
		title: "One-Click Join",
		description: "Convenient Discord buttons to instantly connect players to your server directly from Discord.",
		icon: Gamepad2,
	},
	{
		title: "Modern Interface",
		description: "Modern, intuitive Discord UI for commands, interactive panels, and bot management, utilizing ComponentsV2.",
		icon: Sparkles,
	}
];
---

<section id="features" class="w-full py-24 border-b border-border px-6 sm:px-10 lg:px-16 relative z-10 bg-zinc-950/20 backdrop-blur-sm scroll-reveal opacity-0 translate-y-8 transition-all duration-1000 ease-out">
    <div class="mx-auto max-w-7xl space-y-16">
        <div class="text-center space-y-6 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold tracking-tight sm:text-5xl text-foreground">
                Features & Capabilities
            </h2>
            <p class="text-lg text-muted-foreground">
                Everything you need to seamlessly integrate your game servers with your Discord community.
            </p>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4">
            {FEATURES.map(feature => {
                const Icon = feature.icon;
                return (
                    <div class="w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(25%-0.75rem)]">
                        <AnimatedGradientWrapper client:load 
                            baseBorderOpacity="opacity-0 group-hover:opacity-30"
                            className="h-full hover:-translate-y-px hover:brightness-125"
                        >
                            <Card className="flex flex-col h-full border-0 bg-card rounded-[12px] shadow-none overflow-hidden m-0">
                                <CardHeader>
                                    <div class="flex items-start justify-between">
                                        <div class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                                            <Icon className="size-5" />
                                        </div>
                                        {feature.tags && feature.tags.length > 0 && (
                                            <div class="flex flex-wrap items-center justify-end gap-1">
                                                {feature.tags.map((tag) => (
                                                    <span
                                                        class={`text-[0.65rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border ${tag.color ?? "bg-secondary text-secondary-foreground border-transparent"}`}
                                                    >
                                                        {tag.name}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                    <CardTitle className="text-lg mt-3">
                                        {feature.title}
                                    </CardTitle>
                                </CardHeader>
                                <CardContent className="flex-1">
                                    <CardDescription className="text-sm">
                                        {feature.description}
                                    </CardDescription>
                                </CardContent>
                            </Card>
                        </AnimatedGradientWrapper>
                    </div>
                );
            })}
        </div>
    </div>
</section>
