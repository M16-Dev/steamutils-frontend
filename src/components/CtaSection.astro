---
import { AddBotPrimaryButton } from "@/components/ui/add-bot-primary-button";
import { LINKS } from "@/lib/config";
import { AnimatedGradientWrapper } from "@/components/ui/animated-gradient-wrapper";
---

<section id="cta" class="flex min-h-[calc(100vh-4rem)] w-full flex-col items-center justify-center py-24 px-4 sm:px-6 relative z-10 scroll-reveal opacity-0 translate-y-8 transition-all duration-1000 ease-out">
    <AnimatedGradientWrapper 
        client:load 
        className="mx-auto max-w-4xl w-full p-0 sm:p-0.5 bg-transparent sm:bg-border"
        baseGlowOpacity="opacity-0 sm:opacity-60 sm:group-hover:opacity-60"
        baseBorderOpacity="opacity-0 sm:opacity-40 sm:group-hover:opacity-40"
    >
        <div class="bg-background w-full h-full px-4 py-16 sm:py-28 sm:px-20 text-center flex flex-col space-y-8">
            <h2 class="text-5xl font-extrabold sm:text-6xl bg-linear-to-b from-white to-zinc-300 bg-clip-text text-transparent">
                Ready to enhance your community?
            </h2>
            <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto">
                Provide perfect integration and seamless experience for you and your players today.
            </p>
            <div class="flex justify-center pt-8">
                <a href={LINKS.botInviteUrl}>
                    <AddBotPrimaryButton client:load>
                        Add SteamUtils to server
                    </AddBotPrimaryButton>
                </a>
            </div>
        </div>
    </AnimatedGradientWrapper>
</section>
