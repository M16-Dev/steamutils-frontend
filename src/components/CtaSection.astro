---
import { Button } from "@/components/ui/button";
import { Plus } from "lucide-react";
import { LINKS } from "@/lib/config";
---

<section id="cta" class="flex min-h-[calc(100vh-4rem)] w-full flex-col items-center justify-center py-24 px-4 sm:px-6 relative z-10">
    <div class="mx-auto max-w-4xl text-center space-y-8">
        <h2 class="text-4xl font-bold tracking-tight sm:text-6xl text-foreground">
            Ready to enhance your community?
        </h2>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
            Provide perfect integration and seamless experience for you and your players today.
        </p>
        <div class="flex justify-center pt-8">
            <a href={LINKS.botInviteUrl}>
                <Button client:load size="xl" className="cursor-pointer font-semibold shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform">
                    <Plus className="size-5 mr-2" />
                    Add SteamUtils to server
                </Button>
            </a>
        </div>
    </div>
</section>
